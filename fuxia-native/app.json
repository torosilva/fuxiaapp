{
  "expo": {
    "name": "Fuxia Ballerinas",
    "slug": "fuxia-native",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon-brand.png",
    "scheme": "fuxia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuxiaballerinas.app",
      "buildNumber": "9",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Usamos tu galería para personalizar la foto de tu tarjeta de lealtad.",
        "NSCameraUsageDescription": "Usamos la cámara para escanear tarjetas de lealtad en tienda y para tomar la foto de tu perfil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fuxiaballerinas.loyalty",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-brand.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la camara para escanear tarjetas de lealtad en tienda y para tomar la foto de tu perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tu galería para personalizar la foto de tu tarjeta de lealtad."
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef3a377e-9d71-4309-a144-c4d18ec1dfa2"
      }
    },
    "owner": "torosilva",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ef3a377e-9d71-4309-a144-c4d18ec1dfa2"
    }
  }
}
